# ==============================================================================
# fade-out — Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# --- AI Services ---

# OpenAI API key — used for tracklist analysis, title generation, descriptions
OPENAI_API_KEY=sk-...

# fal.ai API key — used for AI thumbnail/cover art generation
FAL_API_KEY=fal-...

# AudD API token — optional paid fingerprinting fallback used for mix segments
# the Shazam identifier misses. Get one at https://dashboard.audd.io
AUDD_API_TOKEN=

# --- SoundCloud ---

# SoundCloud API credentials (preferred — faster, more reliable)
# Register an app at https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=your-client-id
SOUNDCLOUD_CLIENT_SECRET=your-client-secret
SOUNDCLOUD_ACCESS_TOKEN=  # Set after OAuth flow, or leave blank for auto-auth
SOUNDCLOUD_REFRESH_TOKEN=  # Set after OAuth flow

# SoundCloud account credentials (fallback — used for password grant or browser auth)
SOUNDCLOUD_EMAIL=you@example.com
SOUNDCLOUD_PASSWORD=your-password

# --- YouTube ---

# YouTube Data API OAuth2 credentials
# Create at: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# --- Mixcloud (optional, OFF by default) ---

# Third publishing target. The whole path is gated: nothing is uploaded unless
# MIXCLOUD_ENABLED=true AND a valid access token is present. Register an app at
# https://www.mixcloud.com/developers/ and complete the OAuth flow to get a token.
MIXCLOUD_ENABLED=false
MIXCLOUD_ACCESS_TOKEN=  # OAuth access token (required for uploads)
MIXCLOUD_CLIENT_ID=  # OAuth client id (for future token refresh)
MIXCLOUD_CLIENT_SECRET=  # OAuth client secret (for future token refresh)

# --- Notifications ---

# Discord webhook URL for upload notifications (optional)
NOTIFICATION_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- General ---

# Public URL for OAuth callbacks (required for YouTube/Google OAuth which needs a real domain)
# Set this to your Cloudflare Tunnel, reverse proxy, or public domain URL
# Example: https://fadeout.example.com
PUBLIC_URL=

# Timezone, IANA name (e.g. Europe/Berlin, America/New_York)
TZ=UTC

# Browser origins allowed to call the API, comma-separated. The dashboard is
# served from the same origin as the API, so most deployments need nothing here;
# these defaults exist for the Vite dev server, and PUBLIC_URL is added
# automatically when set.
#
# Do not set this to "*". fade-out has no authentication, so a wildcard lets any
# website you visit read your stored credential metadata and drive your
# pipeline. See SECURITY.md.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Host paths (bind mounts) ---

# Where your media actually lives on the host. These are consumed by
# docker-compose.yml. Defaults put everything under ./media/ next to the compose
# file; point them at your NAS shares instead if you have one, e.g.
#   WATCH_AUDIO_DIR=/volume1/music/mixes
#
# Audio and video are mounted read-write so the optional source-file renaming
# feature can work; the rest are read-only.
WATCH_AUDIO_DIR=./media/audio
WATCH_VIDEO_DIR=./media/video
WATCH_CUE_DIR=./media/cue-sheets
WATCH_SHORTS_DIR=./media/shorts
OUTPUT_THUMBNAILS_DIR=./media/thumbnails
OUTPUT_COVER_ART_DIR=./media/cover-art

# --- Back-catalog title cleanup ---

# When fade-out imports your existing SoundCloud/YouTube catalog it strips
# retired show wording out of old titles. Set these to YOUR channel and series
# names — the defaults are the original author's and will not match anything of
# yours. Leave them empty if you have no recurring show names.
#
# Universal markers ("Raid Train", "Twitch", "untitled", bare dates) are always
# stripped and need no configuration.
CATALOG_CHANNEL_NAME=
CATALOG_SERIES_NAMES=

# --- Optional integrations ---

# Live DJCTL WebSocket feed. Empty = disabled.
DJCTL_WS_URL=

# --- Deployment freshness / auto-upgrade ---

# Read-only GitHub credential for the release comparison behind
# /api/health -> deployment and /api/upgrade/status.
#
# Required when GITHUB_REPO is PRIVATE. GitHub answers 404 — not 403 — for a
# private repo the caller cannot read, so without a credential "no releases
# published" and "you cannot see this repo" are the same response, and the
# check refuses to guess: it reports state=error, stale=null, and says so.
# It never degrades to "up to date".
#
# LEAST PRIVILEGE: this only ever reads release and tag metadata. Use a
# fine-grained personal access token scoped to this one repository with
# Repository permissions -> Contents: Read-only. Nothing else is used, and a
# token with write scopes hands a monitoring loop the ability to change the
# repo it is watching. A token that authenticates but cannot see the repo is
# reported as an error, not as a clean bill of health.
#
# Keep the value in a secret manager and inject it at deploy time; never
# commit it and never bake it into the image.
GITHUB_TOKEN=

# --- Robustness / ingest safety (all optional; sane defaults) ---

# Partial-file safety: a stable file is only ingested once it clears this floor,
# killing the 0-byte / stray-file class. Also requires N consecutive same-size
# polls (STABILITY_CONFIRMATIONS) on top of FILE_STABLE_SECONDS.
MIN_FILE_SIZE_BYTES=1048576
STABILITY_CONFIRMATIONS=2

# Out-of-order pairing: a lone audio-only or video-only drop waits this long for
# its date-matched sibling before the wait expires (audio-only then runs;
# video-only is logged as unpaired and not run). The sweeper re-checks this often.
PAIRING_WAIT_SECONDS=7200
PAIRING_SWEEP_INTERVAL_SECONDS=30

# Disk safety: refuse to ingest when free space on the output volume is below this.
MIN_FREE_DISK_GB=5.0

# Source-file renaming: rename the watched audio/video to
# "YYYY-MM-DD <title>.<ext>" once a run completes, so the archive on disk
# matches the published catalog. OFF by default -- this is the only feature
# that writes to the watch folders, and it also needs those bind mounts set to
# :rw in docker-compose.yml (with :ro every rename is skipped and logged).
RENAME_SOURCE_FILES=false
